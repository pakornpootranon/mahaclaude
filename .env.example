# Postgres connection used by both web (Prisma) and worker (SQLAlchemy).
# Points at a Postgres running on this machine; `make setup` creates the role
# and database with these credentials.
DATABASE_URL=postgresql://newswatch:newswatch@localhost:5432/newswatch

# Claude API key — fallback used by worker/llm/client.py when no key is set in
# Settings -> LLM (the DB-stored key, entered via the UI, always wins). Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Finnhub News API — free tier. Sign up at https://finnhub.io/register
FINNHUB_KEY=

# NewsAPI.org — free developer tier. Sign up at https://newsapi.org/register
NEWSAPI_KEY=

# Bigdata.com MCP connector auth token. Only needed if you enable the seeded
# (disabled-by-default) Bigdata.com source. Sign up at https://bigdata.com
BIGDATA_API_KEY=
